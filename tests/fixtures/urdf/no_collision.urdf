<?xml version="1.0"?>
<!--
  BROKEN FIXTURE (a): visual geometry only, no <collision> on any link.

  MuJoCo's URDF importer discards visuals by default, so this compiles to a model with
  ZERO geoms: the robot has nothing to stand on or collide with, every contact-derived
  failure metric is vacuous, and the simulation still "runs". load_urdf_model must reject
  it instead.
-->
<robot name="no_collision_bot">
  <link name="base">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </visual>
  </link>
  <link name="arm">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
    </visual>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10.0" velocity="10.0"/>
  </joint>
</robot>
